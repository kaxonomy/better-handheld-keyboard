#!/usr/bin/env bash
# Write the handheld-kbd-opacity KWin script.
#
# ONE writer, called by everything that needs the script to exist: the installer, the swap
# daemon, and the keyboard's opacity key. It used to be two — a static copy shipped by the
# installer and a generated one written by the daemon — which diverged: the static copy
# hardcoded its opacity and had no `var OP` line, so the opacity key silently patched
# nothing and every reload snapped the keyboard back to 0.72.
#
#   handheld-kbd-kwin-script [--opacity 0.72] [--hide-steam 0|1] [--out PATH]
#   --diagnostics / --close-steam produce one-shot scripts without changing placement.
#   --debug enables metadata and geometry logging in the KWin journal.
#
# --hide-steam 0 leaves Steam's on-screen keyboard alone; the daemon only passes 1 once
# this keyboard has proven it can appear (see handheld-kbd-swap.sh).
#
# --mirror 1 makes the script drive the keyboard from Steam's OSK: when that window maps
# we call Show on the keyboard's DBus service, when it goes we call Hide. That replaced a
# 10Hz xwininfo/xprop poll in the daemon, which cost constant CPU and added up to 100ms to
# every summon.
set -uo pipefail

OUT="$HOME/.local/share/kwin/scripts/handheld-kbd-opacity/contents/code/main.js"
OP=""
HIDE_STEAM=1
MIRROR=""
REPORT=0        # 1 while the user is moving the keyboard by hand: report its geometry back
DOCK_OVERRIDE=""  # force docking off while the user is dragging, whatever the config says
DEBUG=""
ACTION="run"

while [ $# -gt 0 ]; do
    case "$1" in
        --opacity)    OP="${2:-}"; shift 2 ;;
        --hide-steam) HIDE_STEAM="${2:-1}"; shift 2 ;;
        --mirror)     MIRROR="${2:-0}"; shift 2 ;;
        --report)     REPORT="${2:-0}"; shift 2 ;;
        --dock)       DOCK_OVERRIDE="${2:-}"; shift 2 ;;
        --debug)      DEBUG=1; shift ;;
        --diagnostics) ACTION="diagnostics"; shift ;;
        --close-steam) ACTION="close-steam"; shift ;;
        --out)        OUT="${2:-$OUT}"; shift 2 ;;
        --print)      OUT="/dev/stdout"; shift ;;
        *) echo "handheld-kbd-kwin-script: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

# Default to whatever the config says, so callers don't have to parse JSON themselves.
if [ -z "$OP" ]; then
    OP=$(python3 -c 'import json,os
try: print(float(json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json")))["opacity"]))
except Exception: print(0.72)' 2>/dev/null)
fi
case "$OP" in ''|*[!0-9.]*) OP=0.72 ;; esac

# Docking is decided in here, by KWin, because KWin is the only thing that knows the work
# area: logical pixels (so display scaling is already accounted for) minus the panels. A
# 1920x1200 panel at scale 1.5 is a 1280x800 desktop, and the Plasma panel takes a slice
# off the bottom of that — neither is visible from outside the compositor.
# PLACE: dock (we compute the bottom strip), custom (the rect the user chose), or none
# (they are dragging it right now — hands off). ONE authority for placement: this script.
# KWin window rules are deliberately not used to position the keyboard, because a Force or
# Remember rule and this script each keep re-asserting their own idea of where the window
# belongs — which is what made a dragged keyboard snap back a second later.
DOCK_CFG=$(python3 -c 'import json,os
try:
    d = json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json")))
except Exception:
    d = {}
g = d.get("geometry") or {}
try:
    lvl = int(d.get("size_level", 1 if d.get("start_big") else 0))
except Exception:
    lvl = 1 if d.get("start_big") else 0
frac = [d.get("dock_height_frac", 0.42), d.get("big_height_frac", 0.55), d.get("huge_height_frac", 0.68), d.get("mega_height_frac", 0.82)][max(0, min(3, lvl))]
try:
    frac = float(frac)
except Exception:
    frac = 0.42
mode = d.get("position_mode", "bottom")
if mode == "free":
    place = "none"          # the user placed it and we could not read the rect: hands off
elif mode == "custom" and g.get("w") and g.get("h"):
    place = "custom"
else:
    place = "dock"
try:
    margin = max(0, int(d.get("dock_bottom_margin", 0)))
except (TypeError, ValueError):
    margin = 0
print(place, max(0.15, min(frac, 0.95)),
      int(g.get("x", 0)), int(g.get("y", 0)), int(g.get("w", 0)), int(g.get("h", 0)),
      margin, 1 if d.get("kwin_fullscreen_lift", True) else 0,
      1 if d.get("debug", False) else 0)' 2>/dev/null)
set -- $DOCK_CFG
PLACE="${1:-dock}"; FRAC="${2:-0.42}"; CX="${3:-0}"; CY="${4:-0}"; CW="${5:-0}"; CH="${6:-0}"
MARGIN="${7:-0}"; LIFT="${8:-1}"; DEBUG="${DEBUG:-${9:-0}}"
# An explicit --dock wins: free-move has to turn docking off even though the config still
# says "bottom", or the keyboard is dragged straight back the moment the user lets go.
# --dock 0 means the user is dragging: no placement at all until they finish.
case "$DOCK_OVERRIDE" in 0) PLACE="none" ;; 1) PLACE="dock" ;; esac
# A runtime fallback beats the config: the daemon sets this when the hardware-button remap
# could not be applied, and without honouring it here every regeneration of this script
# would turn mirroring back off while the button is still dead.
if [ -z "$MIRROR" ] && [ -f /tmp/handheld-kbd.mirror-fallback ]; then
    MIRROR=1
fi
if [ -z "$MIRROR" ]; then
    MIRROR=$(python3 -c 'import json,os
try: print(0 if json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json"))).get("mirror", True) is False else 1)
except Exception: print(1)' 2>/dev/null)
fi
case "$MIRROR" in 0|1) : ;; *) MIRROR=1 ;; esac
case "$PLACE" in dock|custom|none) : ;; *) PLACE=dock ;; esac
case "$FRAC" in ''|*[!0-9.]*) FRAC=0.42 ;; esac
for v in CX CY CW CH; do
    eval "val=\$$v"; case "$val" in ''|*[!0-9-]*) eval "$v=0" ;; esac
done

case "$HIDE_STEAM" in 1) CLOSE_STEAM=1 ;; *) CLOSE_STEAM=0 ;; esac
case "$REPORT" in 1) : ;; *) REPORT=0 ;; esac
case "$DEBUG" in 1) : ;; *) DEBUG=0 ;; esac

[ "$OUT" = "/dev/stdout" ] || mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<EOF
// Better Handheld Keyboard KWin helper: (1) set our OSK's opacity + hide Steam's OSK,
// (2) keep the OSK visible above fullscreen windows (e.g. Chrome video fullscreen),
// (3) place the keyboard without changing application focus.
// Generated by handheld-kbd-kwin-script — edits here are overwritten.
var OP = $OP;
var MIRROR = $MIRROR;   // 1 = follow Steam's OSK (the device has no dedicated button)
var DEBUG = $DEBUG;
var ACTION = "$ACTION";
var REPORT = $REPORT;   // 1 = tell the keyboard where it ends up (free-move is on)
var PLACE = "$PLACE";  // "dock" | "custom" | "none" (the user is moving it by hand)
var FRAC = $FRAC;      // dock height as a fraction of the usable area
var BOTTOM_MARGIN = $MARGIN; // logical pixels above the usable bottom edge
var CUSTOM = { x: $CX, y: $CY, width: $CW, height: $CH };
var FULLSCREEN_LIFT = $LIFT;
// Close Steam's on-screen keyboard rather than just hiding it. While Steam believes its
// OSK is open it forces the controller into its "KB ActionSet", where the sticks and
// trackpads navigate that keyboard instead of moving the desktop pointer — so a Steam
// Deck loses its trackpad and stick mouse for as long as the window exists, even at
// zero opacity, and only gets them back when Steam restarts. Closing the window makes
// Steam set OSK-active back to 0 and reload the desktop controller config.
var CLOSE_STEAM = $CLOSE_STEAM;
var demoted = {};   // internalId -> true : fullscreen windows WE dropped to keepBelow

function isKbd(w){ return ("" + w.resourceClass).indexOf("handheld-kbd") !== -1; }

function debug(message){ if (DEBUG) print("HHKBD " + message); }
function failed(action, error){ print("HHKBD " + action + " failed: " + error); }
function textProp(w, name){
    try { return w[name] === undefined || w[name] === null ? "" : "" + w[name]; }
    catch(e){ return ""; }
}
function steamIdentity(w){
    var identity = [textProp(w, "resourceClass"), textProp(w, "resourceName"),
                    textProp(w, "desktopFileName")].join(" ").toLowerCase();
    return /(^|[ /])(steam|steamwebhelper|steam_osx|com\.valvesoftware\.steam)([ ._-]|$)/.test(identity);
}
function isSteamOsk(w){
    if (!w || !steamIdentity(w)) return false;
    var cap = textProp(w, "caption").trim().toLowerCase();
    var role = textProp(w, "windowRole").toLowerCase();
    var identity = [textProp(w, "resourceClass"), textProp(w, "resourceName"),
                    textProp(w, "desktopFileName")].join(" ").toLowerCase();
    // A Steam identity AND a keyboard-specific title/role are required. In particular,
    // a browser displaying a page about Steam's keyboard must never be closed.
    return /^(?:(?:steam(?: input)?|sp)[ :_-]+)?(?:on[- ]?screen[ _-]+|virtual[ _-]+)?keyboard(?:[ _-]+[-–—][ _-]+steam)?$/.test(cap) ||
           /^(steam[- _]?)?(osk|keyboard|on[- _]?screen[- _]?keyboard)$/.test(role) ||
           /(^|[ /])steam[-_.](osk|keyboard)([ ._-]|$)/.test(identity);
}
function windowMetadata(w){
    var result = {};
    ["resourceClass", "resourceName", "desktopFileName", "windowRole", "internalId", "pid", "layer", "keepAbove"].forEach(function(key){
        result[key] = textProp(w, key);
    });
    // Ordinary Steam titles can include chat or browser text. Only identified OSK
    // captions are logged; all other candidates still expose class/name/role metadata.
    result.caption = isSteamOsk(w) ? textProp(w, "caption") : "";
    result.steamOsk = isSteamOsk(w);
    result.keyboard = isKbd(w);
    var g = w.frameGeometry;
    if (g) result.geometry = {x: g.x, y: g.y, w: g.width, h: g.height};
    if (isKbd(w) && g) {
        var area = workspace.clientArea(KWin.MaximizeArea, w);
        result.usableArea = {x: area.x, y: area.y, w: area.width, h: area.height};
        result.bottomMargin = area.y + area.height - g.y - g.height;
    }
    return result;
}
function setOp(w){
    try {
        if (isKbd(w)) w.opacity = OP;
        else if (CLOSE_STEAM && isSteamOsk(w)) w.opacity = 0.0;
    } catch(e){ failed("opacity", e); }
}

// GTK hide() destroys the OSK's Wayland surface, so a present, non-minimized
// handheld-kbd window means the keyboard is currently shown.
function shownKbd(){
    var list = workspace.windowList();
    for (var i = 0; i < list.length; i++)
        if (isKbd(list[i]) && !list[i].minimized) return list[i];
    return null;
}

// A fullscreen window sits in KWin's ActiveLayer, above the OSK's keep-above
// AboveLayer, so it covers the keyboard. keepBelow is evaluated before
// activeFullScreen, so dropping the fullscreen window to keepBelow (BelowLayer)
// lets the OSK float on top. Restore it when the OSK hides / leaves fullscreen.
function applyStack(){
    if (!FULLSCREEN_LIFT) return;
    try {
        var kbd = shownKbd();
        // The installed layer=osd rule puts us in KWin's OnScreenDisplayLayer (8),
        // above popups and fullscreen. Only old installations need the fallback.
        // KWin still excludes ordinary windows from the locked screen in any layer.
        var needsLift = kbd && !(typeof kbd.layer === "number" && kbd.layer >= 8);
        var list = workspace.windowList();
        for (var i = 0; i < list.length; i++){
            var w = list[i];
            if (isKbd(w)) continue;
            var id = "" + w.internalId;
            if (needsLift && w.fullScreen){
                if (!w.keepBelow){ w.keepBelow = true; demoted[id] = true; }
            } else if (demoted[id]){
                w.keepBelow = false;
                delete demoted[id];
            }
        }
    } catch(e){}
}

// Dock the keyboard along the bottom of the usable area of whichever screen it is on.
// clientArea(MaximizeArea) is in logical pixels and already excludes panels, so this is
// right at any resolution, any scale factor, and with a panel of any size on any edge.
var placing = false;   // re-entry guard: we resize the window inside its own signal
var placedCustom = {};  // a custom spot is applied once per window, never re-asserted
function dockKbd(w){
    if (PLACE === "none" || !isKbd(w) || placing) return;
    placing = true;
    if (PLACE === "custom") {
        if (placedCustom["" + w.internalId]) { placing = false; return; }
        placedCustom["" + w.internalId] = true;
        try {
            var cg = w.frameGeometry;
            cg.x = CUSTOM.x; cg.y = CUSTOM.y;
            cg.width = CUSTOM.width; cg.height = CUSTOM.height;
            w.frameGeometry = cg;
        } catch(e){}
        placing = false;
        return;
    }
    try {
        var area = workspace.clientArea(KWin.MaximizeArea, w);
        var h = Math.max(120, Math.round(area.height * FRAC));
        var geo = w.frameGeometry;
        geo.x = area.x; geo.width = area.width;
        geo.height = h; geo.y = Math.max(area.y, area.y + area.height - h - BOTTOM_MARGIN);
        w.frameGeometry = geo;
        // The client has a minimum size, so it may come back taller than we asked. Re-anchor
        // to whatever it actually became, or the extra height hangs off the bottom edge.
        var got = w.frameGeometry;
        if (got.height !== h || got.width !== area.width) {
            got.x = area.x;
            got.y = Math.max(area.y, area.y + area.height - got.height - BOTTOM_MARGIN);
            w.frameGeometry = got;
        }
    } catch(e){}
    placing = false;
}

function watch(w){
    try { w.fullScreenChanged.connect(applyStack); w.minimizedChanged.connect(applyStack); } catch(e){}
    if (REPORT && isKbd(w)) { watchGeometry(w); reportGeometry(w); }
    // Steam can set its title after mapping; inspect it again when metadata settles.
    try { w.captionChanged.connect(function(){ handleSteam(w); }); } catch(e){}
    try { w.desktopFileNameChanged.connect(function(){ handleSteam(w); }); } catch(e){}
    // Keep it pinned: GTK can settle on a different height slightly after we place it
    // (the suggestion row, a font metric), which would otherwise leave the keyboard
    // floating short of the bottom edge until something else moved it.
    // Only the dock re-asserts itself. A custom spot is placed once and then left alone,
    // so the keyboard behaves like a normal window you happened to put there.
    if (PLACE === "dock" && isKbd(w)) {
        try { w.frameGeometryChanged.connect(function(){ dockKbd(w); }); } catch(e){}
    }
}

// While the user is dragging the keyboard, tell it where it actually is. A Wayland client
// cannot ask, and a KWin "Remember" rule is not written back to kwinrulesrc until the
// window closes — reading that file mid-session returns the previous forced rect, which is
// why finishing a move used to snap the keyboard back to where it started.
function reportGeometry(w){
    try {
        var g = w.frameGeometry;
        debug("geometry changed " + g.x + "," + g.y + "," + g.width + "," + g.height);
        callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
                 "org.handheld.Keyboard", "SetGeometry",
                 "" + g.x + "," + g.y + "," + g.width + "," + g.height);
    } catch(e){ failed("geometry report", e); }
}

function watchGeometry(w){
    // Signal names have moved around between KWin versions, so connect to whichever exist
    // rather than assuming. Each is wrapped: one missing signal must not stop the others.
    var signals = ["frameGeometryChanged", "geometryChanged", "moveResizedChanged",
                   "interactiveMoveResizeFinished", "interactiveMoveResizeStepped"];
    var connected = 0;
    for (var i = 0; i < signals.length; i++) {
        try {
            if (w[signals[i]] && w[signals[i]].connect) {
                w[signals[i]].connect(function(){ reportGeometry(w); });
                connected++;
            }
        } catch(e){}
    }
    debug("watching geometry via " + connected + " signal(s)");
}
// Steam's OSK opening is the hardware keyboard button being pressed. Deal with it:
// summon or dismiss ours, then get Steam's out of the way for real.
//
// Closing it means Steam no longer tells us when the button is pressed a second time —
// it just opens a fresh OSK — so the button has to toggle here rather than relying on
// Steam's own show/hide. The guard is against Steam re-mapping the window on its way
// out, which would otherwise read as a second press and immediately undo the first.
var lastSteamOsk = 0;
function onSteamOsk(w){
    var now = new Date().getTime();
    if (now - lastSteamOsk < 700) { if (CLOSE_STEAM) closeSteamOsk(w); return; }
    lastSteamOsk = now;
    if (CLOSE_STEAM) closeSteamOsk(w);
    // HHD sees the same physical event and opens Steam's OSK independently of
    // Steam Input. Its direct M1 listener already toggled ours: never toggle twice.
    callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
             "org.handheld.Keyboard", "SteamOsk", CLOSE_STEAM ? "Toggle" : "Show");
}

function closeSteamOsk(w){
    try {
        w.opacity = 0.0;
        w.closeWindow();
        debug("Steam OSK suppressed/closed " + JSON.stringify(windowMetadata(w)));
    } catch(e){ failed("Steam OSK close", e); }
}
var seenSteam = {};
function handleSteam(w){
    if (!isSteamOsk(w)) return;
    var id = textProp(w, "internalId");
    if (seenSteam[id]) return;
    seenSteam[id] = true;
    debug("Steam OSK detected " + JSON.stringify(windowMetadata(w)));
    if (MIRROR) onSteamOsk(w);
    else if (CLOSE_STEAM) closeSteamOsk(w);
}

function onAdded(w){
    setOp(w); watch(w); dockKbd(w); applyStack();
    // Steam's OSK must never be left mapped-but-invisible in ANY trigger mode: setOp
    // just made it transparent, and while it exists Steam holds the controller in its
    // KB ActionSet — no trackpad or stick pointer. Mirror mode also toggles our
    // keyboard off the event; other modes have their own trigger, so just close it.
    handleSteam(w);
    // Focus is prevented before map by GTK hints and the acceptfocus KWin rule.
    // Re-activating a previous app here dismisses Plasma's Application Launcher.
}

function diagnostics(){
    var windows = workspace.windowList().filter(function(w){ return isKbd(w) || steamIdentity(w); });
    var data = JSON.stringify({timestamp: new Date().getTime(), windows: windows.map(windowMetadata)});
    callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
             "org.handheld.Keyboard", "WindowDiagnostics", data);
    debug("window diagnostics " + data);
}

// Pull pending client gesture requests only while unlocked. KWin 6 exposes QTimer
// and writable frameGeometry; no GTK move(), forced rule, or activation is involved.
var moveTimer = null;
var movePending = false;
var moveRequestedAt = 0;
function nextGeometry(){
    var now = new Date().getTime();
    if (movePending && now - moveRequestedAt < 2000) return;
    movePending = true;
    moveRequestedAt = now;
    callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
             "org.handheld.Keyboard", "NextGeometry", function(rect){
        movePending = false;
        if (!rect) return;
        try {
            var g = JSON.parse(rect);
            if (![g.x, g.y, g.w, g.h].every(function(n){ return typeof n === "number" && isFinite(n); }) || g.w <= 0 || g.h <= 0) return;
            workspace.windowList().forEach(function(w){
                if (!isKbd(w)) return;
                debug("KWin movement requested " + rect);
                w.frameGeometry = {x: g.x, y: g.y, width: g.w, height: g.h};
                reportGeometry(w);
            });
        } catch(e){ failed("KWin movement", e); }
    });
}
if (ACTION === "diagnostics") {
    diagnostics();
} else if (ACTION === "close-steam") {
    workspace.windowList().forEach(function(w){ if (isSteamOsk(w)) closeSteamOsk(w); });
} else {

workspace.windowList().forEach(function(w){
    setOp(w); watch(w);
    // Existing windows: in custom placement, mark as already placed so a script reload
    // leaves them untouched. Docking still re-asserts, because that is ours to compute.
    if (PLACE === "custom") placedCustom[""+w.internalId] = true;
    dockKbd(w);
    // A Steam OSK left over from before this script loaded is still holding the
    // controller in KB ActionSet. Close it on sight — this is what gives a Deck its
    // trackpad and stick pointer back without restarting Steam. In every mode: an
    // opacity-0 leftover kills the pointer whether or not we mirror it.
    if (CLOSE_STEAM && isSteamOsk(w)) {
        seenSteam[textProp(w, "internalId")] = true;
        closeSteamOsk(w);
    }
});
workspace.windowAdded.connect(onAdded);
workspace.windowRemoved.connect(function(w){
    applyStack();
    delete seenSteam[textProp(w, "internalId")];
    // Only mirror the close when we are not the ones closing it — otherwise our own
    // closeWindow() would hide the keyboard we just summoned.
    if (MIRROR && !CLOSE_STEAM && isSteamOsk(w)) {
        callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
                 "org.handheld.Keyboard", "SteamOsk", "Hide");
    }
});
applyStack();
if (REPORT) {
    try {
        moveTimer = new QTimer();
        moveTimer.interval = 16;
        moveTimer.timeout.connect(nextGeometry);
        moveTimer.start();
        debug("KWin movement bridge started");
    } catch(e){ failed("KWin movement bridge", e); }
}
}
EOF
