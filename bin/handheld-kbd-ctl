#!/usr/bin/env bash
# Start, stop and restart the keyboard without logging out.
#
# The keyboard normally looks after itself: the supervisor starts it at login and
# respawns it if it dies. This is for the times it doesn't — a bad config edit, a
# wedged Wayland connection, or a position you want to put back.
#
#   handheld-kbd-ctl status      what is running, and where the keyboard is
#   handheld-kbd-ctl diagnostics include live KWin window metadata
#   handheld-kbd-ctl windows     inspect Steam OSK and keyboard windows
#   handheld-kbd-ctl start       start the supervisor (and so the keyboard)
#   handheld-kbd-ctl stop        stop both; nothing respawns until you start it again
#   handheld-kbd-ctl restart     stop, then start — the usual fix
#   handheld-kbd-ctl reset       put the keyboard back on the bottom dock
#
# Every action is safe to repeat: stopping something already stopped is a no-op,
# and starting something already running restarts it rather than running two.
set -u

BIN="$HOME/.local/bin"
DBUS="$BIN/handheld-kbd-dbus"
KBD_PAT='python3 .*handheld-kbd\.py'
SUP_PAT='handheld-kbd-swap\.sh'

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Get out of the keyboard's own cgroup before touching it.
#
# The supervisor runs as a transient systemd unit, and the tray is one of its children —
# so is this script when the tray launches it. Stopping that unit kills its entire cgroup,
# which is the tray, and this script, mid-restart: the stop half ran, the start half never
# did, and the keyboard did not come back. start_new_session() does not help; a cgroup is
# not a session. Re-run ourselves in a transient unit of our own, which nothing here stops.
if [ -z "${HK_DETACHED:-}" ] && command -v systemd-run >/dev/null 2>&1; then
    case "${1:-restart}" in
        start|stop|restart|super-icon|set)
            if grep -qs 'handheld-kbd' /proc/self/cgroup; then
                exec systemd-run --user --collect --quiet --pipe \
                     --unit="handheld-kbd-ctl-$$" --setenv=HK_DETACHED=1 \
                     -- "$0" "$@"
            fi
            ;;
    esac
fi

# Match by pattern but never kill ourselves or our own parents: `handheld-kbd-ctl`
# run from a shell whose argv mentions the pattern would otherwise take the shell
# with it, which is a memorable way to lose an SSH session.
kill_pattern() {
    local pat="$1" sig="${2:-TERM}" p
    for p in $(pgrep -f "$pat" 2>/dev/null); do
        [ "$p" = "$$" ] && continue
        [ "$p" = "$PPID" ] && continue
        kill "-$sig" "$p" 2>/dev/null
    done
}

running() { pgrep -f "$1" >/dev/null 2>&1; }

stop_all() {
    local rule key
    systemctl --user stop handheld-kbd >/dev/null 2>&1
    kill_pattern "$SUP_PAT"           # supervisor first, or it respawns the keyboard
    sleep 0.5
    kill_pattern "$KBD_PAT"
    for _ in $(seq 12); do
        running "$KBD_PAT" || break
        sleep 0.25
    done
    kill_pattern "$KBD_PAT" KILL
    rm -f /tmp/handheld-kbd-swap.lock
    "$DBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript handheld-kbd-opacity >/dev/null 2>&1 || true
    # The pre-map Steam OSK rule must stand down with the replacement keyboard.
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        for rule in 6c4263a8-3263-4d41-85f7-75c704113ed{b,c,d}; do
            for key in acceptfocusrule opacityactiverule opacityinactiverule; do
                kwriteconfig6 --file kwinrulesrc --group "$rule" --key "$key" 0
            done
        done
        "$DBUS" org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
    fi
}

start_all() {
    local attempt
    # Start under the user service manager rather than from this shell. Run over SSH —
    # which is exactly where you end up when the keyboard is the problem — this shell has
    # no display and no session bus, and a keyboard inheriting that comes up unable to
    # open a display or to answer on DBus. The service manager has the real session
    # environment, imported at login.
    if command -v systemd-run >/dev/null 2>&1; then
        systemctl --user reset-failed handheld-kbd >/dev/null 2>&1
        systemd-run --user --collect --unit=handheld-kbd \
            "$BIN/handheld-kbd-swap.sh" >/dev/null 2>&1 \
            || setsid "$BIN/handheld-kbd-swap.sh" >>/tmp/handheld-kbd-out.log 2>&1 &
    else
        setsid "$BIN/handheld-kbd-swap.sh" >>/tmp/handheld-kbd-out.log 2>&1 &
    fi
    for attempt in $(seq 60); do
        # A process exists before GTK/uinput/DBus initialization finishes. Wait for
        # the service, or a following 'toggle show' races startup and fails.
        if running "$KBD_PAT" && busctl --user --timeout=1 call org.handheld.Keyboard \
            /org/handheld/Keyboard org.handheld.Keyboard GetTrigger >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

window_diagnostics() {
    local js name="hhkbd-diagnostics-$$" report
    report="$XDG_RUNTIME_DIR/handheld-kbd-windows.json"
    [ -d "$XDG_RUNTIME_DIR" ] || report="/tmp/handheld-kbd-$(id -u)-windows.json"
    if [ ! -x "$DBUS" ]; then
        echo "KWin windows: unavailable (handheld-kbd-dbus missing; rerun install.sh)"
        return 1
    fi
    js=$(mktemp --suffix=.js) || return 1
    if ! "$BIN/handheld-kbd-kwin-script" --diagnostics --out "$js"; then
        rm -f "$js"
        return 1
    fi
    rm -f "$report"
    if "$DBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" "$name" >/dev/null \
       && "$DBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null; then
        for _ in $(seq 20); do
            [ -s "$report" ] && break
            sleep 0.1
        done
    fi
    "$DBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$name" >/dev/null 2>&1 || true
    rm -f "$js"
    if [ -s "$report" ]; then
        python3 -m json.tool "$report"
    else
        echo "KWin windows: unavailable (KWin or keyboard DBus service did not answer)"
        return 1
    fi
}

case "${1:-restart}" in
    status|diagnostics)
        running "$SUP_PAT" && echo "supervisor: running" || echo "supervisor: stopped"
        running "$KBD_PAT" && echo "keyboard:   running" || echo "keyboard:   stopped"
        echo "visible:    $([ "$(cat /tmp/handheld-kbd.vis 2>/dev/null)" = 1 ] && echo yes || echo no)"
        python3 "$BIN/handheld_kbd_backend.py" --status
        python3 - <<'PY'
import json, os, re, shutil, subprocess

def probe(args):
    if not shutil.which(args[0]):
        return "unavailable"
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=3)
        return p.stdout.strip() if p.returncode == 0 else "unavailable"
    except (OSError, subprocess.TimeoutExpired):
        return "unavailable"

p = os.path.expanduser("~/.config/handheld-kbd/config.json")
try:
    with open(p) as f:
        c = json.load(f)
except (OSError, ValueError) as ex:
    print("config:     %s" % ex)
    c = {}
print("command session: %s (%s)" % (os.environ.get("XDG_SESSION_TYPE", "unknown"),
                                os.environ.get("XDG_CURRENT_DESKTOP", "unknown")))
print("Plasma:     %s" % probe(["plasmashell", "--version"]))
dbus = os.path.expanduser("~/.local/bin/handheld-kbd-dbus")
support = probe([dbus, "org.kde.KWin", "/KWin", "supportInformation"])
for field in ("KWin version", "Operation Mode"):
    match = re.search(r"^" + field + r":\s*(.*)$", support, re.MULTILINE)
    print("%s: %s" % (field, match.group(1) if match else "unavailable"))
print("DBus keyboard service: %s" % probe(["busctl", "--user", "call", "org.freedesktop.DBus",
      "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner", "s", "org.handheld.Keyboard"]))
print("KWin helper loaded: %s" % probe([dbus, "org.kde.KWin", "/Scripting",
      "org.kde.kwin.Scripting.isScriptLoaded", "handheld-kbd-opacity"]))
print("Plasma input method: %s" % probe(["kreadconfig6", "--file", "kwinrc", "--group", "Wayland", "--key", "InputMethod"]))
print("Plasma input-method bridge: %s" % probe(["busctl", "--user", "call", "org.freedesktop.DBus",
      "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner", "s", "org.handheld.Keyboard.InputMethod"]))
for field in ("available", "enabled", "active", "visible"):
    print("Plasma virtual keyboard %s: %s" % (field, probe(["busctl", "--user", "get-property",
          "org.kde.KWin", "/VirtualKeyboard", "org.kde.kwin.VirtualKeyboard", field])))
print("mirror setting: %s" % c.get("mirror", True))
trigger = probe(["busctl", "--user", "call", "org.handheld.Keyboard", "/org/handheld/Keyboard",
                 "org.handheld.Keyboard", "GetTrigger"])
script = os.path.expanduser("~/.local/share/kwin/scripts/handheld-kbd-opacity/contents/code/main.js")
try:
    with open(script) as f:
        generated = f.read()
    for key, label in (("MIRROR", "mirror effective"), ("CLOSE_STEAM", "hide_steam")):
        match = re.search(r"var " + key + r" = ([01]);", generated)
        value = match.group(1) if match else "unknown"
        if key == "MIRROR" and trigger == 's "ally-m1"':
            value = "0 (direct M1 listener ready)"
        print("%s: %s" % (label, value))
except OSError:
    print("hide_steam: unknown (helper not generated)")
print("position:   %s" % c.get("position_mode", "bottom"))
print("saved geometry: %s" % c.get("geometry", "none"))
print("bottom margin: %s logical px" % c.get("dock_bottom_margin", 0))
PY
        window_diagnostics || true
        ;;
    windows)
        window_diagnostics
        ;;
    stop)
        stop_all
        echo "keyboard stopped. 'handheld-kbd-ctl start' brings it back."
        ;;
    start)
        stop_all                      # idempotent: never end up with two supervisors
        start_all && echo "keyboard started." || { echo "keyboard service did not start — see /tmp/handheld-kbd-out.log" >&2; exit 1; }
        ;;
    restart)
        stop_all
        start_all && echo "keyboard restarted." || { echo "keyboard service did not come back — see /tmp/handheld-kbd-out.log" >&2; exit 1; }
        ;;
    reset)
        # Ask the running keyboard first so the change is visible immediately; fall
        # back to editing the config for a keyboard that isn't up to answer.
        if busctl --user call org.handheld.Keyboard /org/handheld/Keyboard \
                 org.handheld.Keyboard Reset >/dev/null 2>&1; then
            echo "keyboard reset to the bottom dock."
        else
            python3 - <<'PY'
import json, os
p = os.path.expanduser("~/.config/handheld-kbd/config.json")
try:
    c = json.load(open(p))
except Exception:
    c = {}
c["position_mode"] = "bottom"
c.pop("geometry", None)
os.makedirs(os.path.dirname(p), exist_ok=True)
json.dump(c, open(p, "w"), indent=2)
PY
            echo "position reset; it applies next time the keyboard starts."
        fi
        ;;
    super-icon)
        # Set which OS logo the super/meta key wears, then restart so it re-renders.
        icon="${2:-}"
        case "$icon" in
            windows|arch|tux) ;;
            *) echo "usage: handheld-kbd-ctl super-icon {windows|arch|tux}" >&2; exit 2 ;;
        esac
        python3 - "$icon" <<'PY'
import json, os, sys
p = os.path.expanduser("~/.config/handheld-kbd/config.json")
try:
    c = json.load(open(p))
except Exception:
    c = {}
c["super_icon"] = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
json.dump(c, open(p, "w"), indent=2)
PY
        stop_all
        start_all && echo "super key icon set to $icon." \
            || { echo "icon set; keyboard did not come back — see /tmp/handheld-kbd-out.log" >&2; exit 1; }
        ;;
    set)
        # Generic config setter for the tray's Settings menu (and the command line):
        # write one key, then restart so the keyboard re-reads it. `type` tells us how to
        # store the value — bool/int/float/str — defaulting to a best guess.
        #   handheld-kbd-ctl set prediction false bool
        #   handheld-kbd-ctl set layout compact str
        #   handheld-kbd-ctl set suggestion_count 4 int
        key="${2:-}"; val="${3:-}"; typ="${4:-auto}"
        [ -n "$key" ] || { echo "usage: handheld-kbd-ctl set <key> <value> [bool|int|float|str]" >&2; exit 2; }
        python3 - "$key" "$val" "$typ" <<'PY' || { echo "handheld-kbd-ctl: could not set config" >&2; exit 1; }
import json, os, sys
key, val, typ = sys.argv[1], sys.argv[2], sys.argv[3]


def coerce(v, t):
    if t == "bool":
        return v.strip().lower() in ("1", "true", "yes", "on")
    if t == "int":
        return int(v)
    if t == "float":
        return float(v)
    if t == "str":
        return v
    low = v.strip().lower()          # auto: infer from the literal
    if low in ("true", "false"):
        return low == "true"
    for cast in (int, float):
        try:
            return cast(v)
        except ValueError:
            pass
    return v


p = os.path.expanduser("~/.config/handheld-kbd/config.json")
try:
    c = json.load(open(p))
except Exception:
    c = {}
value = coerce(val, typ)
if key == "dock_bottom_margin" and (type(value) is not int or value < 0):
    raise SystemExit("dock_bottom_margin must be a non-negative integer in logical pixels")
c[key] = value
os.makedirs(os.path.dirname(p), exist_ok=True)
with open(p + ".tmp", "w") as f:
    json.dump(c, f, indent=2)
os.replace(p + ".tmp", p)
PY
        stop_all
        start_all && echo "$key set to $val." \
            || { echo "$key set; keyboard did not come back — see /tmp/handheld-kbd-out.log" >&2; exit 1; }
        ;;
    *)
        echo "usage: handheld-kbd-ctl [status|diagnostics|windows|start|stop|restart|reset|super-icon <windows|arch|tux>|set <key> <value> [type]]" >&2
        exit 2
        ;;
esac
